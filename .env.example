# Copy this file to `.env` and fill in real values.
# Do NOT commit the real .env file.

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/group-of-hospital

# Secret used to sign session cookies — use a long random string
SESSION_SECRET=replace-with-a-long-random-string

# Google Gemini API key for the Sahayak chatbot
GEMINI_API_KEY=your-gemini-api-key

# Port the server listens on (optional, defaults to 3000)
PORT=3000

# Set to "production" when deploying
NODE_ENV=development
