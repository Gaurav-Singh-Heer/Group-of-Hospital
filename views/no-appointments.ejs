<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>No Appointments | Group of Hospitals</title>
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    body { min-height: 100vh; display: flex; flex-direction: column; }
    .empty { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 48px 24px; }
    .empty img { max-width: min(420px, 80%); margin-bottom: 24px; }
    .empty h1 { font-size: 1.8rem; margin-bottom: 10px; }
    .empty p { color: var(--ink-500); max-width: 440px; margin-bottom: 26px; }
    .empty .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/home" class="brand"><span class="brand__mark">✚</span> Group of Hospitals</a>
      <nav>
        <ul class="nav-links">
          <li><a href="/home">Home</a></li>
          <li><a href="/appointments">Your Appointments</a></li>
          <li><a href="/logout">Logout</a></li>
        </ul>
      </nav>
      <button class="nav-toggle" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <section class="empty">
    <img src="/assets/no-appt.png" alt="No appointments yet">
    <h1>No appointments yet</h1>
    <p>You haven't booked any appointments. Choose a hospital and schedule your first visit — it only takes a minute.</p>
    <div class="actions">
      <a href="/home" class="btn btn--primary">Book an Appointment</a>
      <a href="/home/contact" class="btn btn--outline">Need Help?</a>
    </div>
  </section>

  <script src="/js/ui.js"></script>
</body>
</html>
