<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group of Hospitals — Comprehensive Health Care</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .hero {
            background: var(--brand-gradient);
            color: #fff;
            padding: 80px 0 90px;
            position: relative;
            overflow: hidden;
        }
        .hero::after {
            content: ""; position: absolute; width: 480px; height: 480px; border-radius: 50%;
            background: rgba(255,255,255,0.08); top: -160px; right: -120px;
        }
        .hero .container { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 40px; position: relative; z-index: 1; }
        .hero h1 { color: #fff; font-size: clamp(2.2rem, 5vw, 3.4rem); margin-bottom: 18px; }
        .hero p { color: rgba(255,255,255,0.92); font-size: 1.12rem; max-width: 520px; margin-bottom: 30px; }
        .hero__cta { display: flex; gap: 14px; flex-wrap: wrap; }
        .hero__image img { filter: drop-shadow(0 20px 40px rgba(0,0,0,0.25)); }
        .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: -46px; position: relative; z-index: 2; }
        .stat { background: #fff; border-radius: var(--radius); padding: 24px; text-align: center; box-shadow: var(--shadow); }
        .stat .num { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 800;
            background: var(--brand-gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .stat .label { color: var(--ink-500); font-size: 0.92rem; margin-top: 4px; }
        .hospitals-preview .grid { margin-top: 10px; }
        .hospital-tile { position: relative; border-radius: var(--radius); overflow: hidden; min-height: 220px;
            display: flex; align-items: flex-end; padding: 24px; color: #fff; background: var(--brand-gradient); }
        .hospital-tile h3 { color: #fff; }
        .cta-band { background: var(--brand-gradient); color: #fff; border-radius: var(--radius-lg); padding: 48px; text-align: center; }
        .cta-band h2 { color: #fff; font-size: 2rem; margin-bottom: 12px; }
        .cta-band p { color: rgba(255,255,255,0.9); margin-bottom: 24px; }
        @media (max-width: 820px) {
            .hero .container { grid-template-columns: 1fr; }
            .hero__image { display: none; }
            .stats { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>

<body>
    <header class="site-header">
        <div class="container">
            <a href="/" class="brand"><span class="brand__mark">✚</span> Group of Hospitals</a>
            <nav>
                <ul class="nav-links">
                    <li><a href="#services">Our Services</a></li>
                    <li><a href="#hospitals">Our Hospitals</a></li>
                    <li><a href="#testimonials">Testimonials</a></li>
                    <li><a href="/login" class="btn btn--primary" style="padding:9px 20px;">Login / Sign Up</a></li>
                </ul>
            </nav>
            <button class="nav-toggle" aria-label="Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <div class="hero__content">
                <h1>Your Health, Our Commitment</h1>
                <p>A trusted network of leading hospitals bringing expert doctors, modern facilities, and compassionate care together in one place.</p>
                <div class="hero__cta">
                    <a href="/login" class="btn btn--accent">Book an Appointment</a>
                    <a href="#hospitals" class="btn btn--ghost">Explore Hospitals</a>
                </div>
            </div>
            <div class="hero__image">
                <img src="/assets/header.svg" alt="Healthcare illustration">
            </div>
        </div>
    </section>

    <div class="container">
        <div class="stats">
            <div class="stat"><div class="num">3+</div><div class="label">Partner Hospitals</div></div>
            <div class="stat"><div class="num">50+</div><div class="label">Expert Doctors</div></div>
            <div class="stat"><div class="num">10k+</div><div class="label">Happy Patients</div></div>
            <div class="stat"><div class="num">24/7</div><div class="label">Support</div></div>
        </div>
    </div>

    <section class="section" id="services">
        <div class="container text-center">
            <span class="eyebrow">What we offer</span>
            <h2 class="section-title">Our Key Services</h2>
            <p class="section-subtitle">End-to-end healthcare designed around you.</p>
            <div class="grid grid--3">
                <div class="card reveal"><div class="card__icon">🩺</div><h3>Emergency Care</h3><p>24/7 emergency services to handle critical situations with expertise.</p></div>
                <div class="card reveal"><div class="card__icon">🏥</div><h3>Inpatient Services</h3><p>Comprehensive care for patients requiring overnight or extended treatment.</p></div>
                <div class="card reveal"><div class="card__icon">⚕️</div><h3>Surgery &amp; Critical Care</h3><p>A highly trained surgical team providing advanced surgeries and critical care.</p></div>
            </div>
        </div>
    </section>

    <section class="section" id="hospitals" style="background:#fff;">
        <div class="container text-center">
            <span class="eyebrow">Our network</span>
            <h2 class="section-title">Hospitals You Can Trust</h2>
            <p class="section-subtitle">Explore our partner hospitals across the region.</p>
            <div class="grid grid--3 hospitals-preview">
                <div class="hospital-tile reveal"><h3>GMCH-32<br><small style="font-weight:400;opacity:.85;">Chandigarh</small></h3></div>
                <div class="hospital-tile reveal"><h3>PGIMER<br><small style="font-weight:400;opacity:.85;">Chandigarh</small></h3></div>
                <div class="hospital-tile reveal"><h3>Max Healthcare<br><small style="font-weight:400;opacity:.85;">Mohali</small></h3></div>
            </div>
            <p style="margin-top:28px;"><a href="/login" class="btn btn--outline">Login to view details</a></p>
        </div>
    </section>

    <section class="section" id="testimonials">
        <div class="container text-center">
            <span class="eyebrow">Patient stories</span>
            <h2 class="section-title">What Our Patients Say</h2>
            <div class="grid grid--3">
                <div class="card reveal"><p>"The doctors and nurses were amazing. I received the best care possible. Highly recommend!"</p><p style="margin-top:14px;font-weight:700;color:var(--ink-900);">— Patient A</p></div>
                <div class="card reveal"><p>"Great experience. The hospital is clean, and the staff is highly professional. Thank you!"</p><p style="margin-top:14px;font-weight:700;color:var(--ink-900);">— Patient B</p></div>
                <div class="card reveal"><p>"A wonderful facility with caring professionals. I felt truly supported during my recovery."</p><p style="margin-top:14px;font-weight:700;color:var(--ink-900);">— Patient C</p></div>
            </div>
        </div>
    </section>

    <section class="section--tight">
        <div class="container">
            <div class="cta-band reveal">
                <h2>Ready to prioritise your health?</h2>
                <p>Create a free account and book your first appointment today.</p>
                <a href="/register" class="btn btn--accent">Get Started</a>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="brand"><span class="brand__mark">✚</span> Group of Hospitals</div>
                    <p>Empowering healthcare every day with a trusted network of hospitals, expert doctors, and compassionate care.</p>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="#services">Services</a></li>
                        <li><a href="#hospitals">Hospitals</a></li>
                        <li><a href="/login">Login</a></li>
                        <li><a href="/register">Sign Up</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Contact</h4>
                    <ul>
                        <li><a href="tel:+911234567890">+91 234 567 890</a></li>
                        <li><a href="mailto:care@groupofhospitals.in">care@groupofhospitals.in</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">&copy; 2024 Group of Hospitals. All rights reserved.</div>
        </div>
    </footer>

    <script src="/js/ui.js"></script>
</body>
</html>
