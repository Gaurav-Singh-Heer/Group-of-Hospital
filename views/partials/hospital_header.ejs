<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || "Hospital" %> | Group of Hospitals</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Hospital hero */
        .hero {
            background: var(--brand-gradient);
            color: #fff; padding: 64px 0 72px;
            position: relative; overflow: hidden;
        }
        .hero::after { content: ""; position: absolute; width: 420px; height: 420px; border-radius: 50%;
            background: rgba(255,255,255,0.08); top: -150px; right: -110px; }
        .hero .container { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 36px; position: relative; z-index: 1; }
        .hero h1 { color: #fff; font-size: clamp(2rem, 4.5vw, 3rem); margin-bottom: 14px; }
        .hero p { color: rgba(255,255,255,0.9); font-size: 1.1rem; }
        .hero img { border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }

        /* Section headings */
        .block { padding: 64px 0; }
        .block > .container > .section-head { text-align: center; margin-bottom: 32px; }

        /* Departments carousel */
        .cards { display: flex; gap: 20px; overflow-x: auto; padding: 8px 4px 20px; scroll-snap-type: x mandatory; }
        .cards::-webkit-scrollbar { height: 8px; }
        .cards::-webkit-scrollbar-thumb { background: var(--brand-300); border-radius: 10px; }
        .cards::-webkit-scrollbar-track { background: var(--surface-muted); border-radius: 10px; }
        .dept-card {
            flex: 0 0 240px; scroll-snap-align: start;
            background: #fff; border: 1px solid rgba(15,23,42,0.06); border-radius: var(--radius);
            padding: 18px; text-align: center; box-shadow: var(--shadow-sm);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .dept-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
        .dept-card img { width: 100%; height: 150px; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: 12px; }
        .dept-card h3 { font-size: 1.05rem; margin-bottom: 6px; }
        .dept-card p { color: var(--ink-500); font-size: 0.88rem; }

        /* Appointment form */
        #appointments { background: var(--surface-muted); }
        .appointment-form {
            max-width: 620px; margin: 0 auto;
            background: #fff; padding: 32px; border-radius: var(--radius); box-shadow: var(--shadow);
            text-align: left;
        }
        .appointment-form label { display: block; font-weight: 600; font-size: 0.9rem; color: var(--ink-700); margin: 0 0 7px; }
        .appointment-form input, .appointment-form select {
            width: 100%; padding: 12px 14px; margin-bottom: 18px; font: inherit; font-size: 0.98rem;
            border: 1.5px solid var(--ink-300); border-radius: var(--radius-sm); color: var(--ink-900);
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .appointment-form input:focus, .appointment-form select:focus { outline: none; border-color: var(--brand-500); box-shadow: var(--ring); }
        .appointment-form button { width: 100%; }

        /* Contact section */
        #contact { background: #fff; }
        .contact-info { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 28px; }
        .info-item { background: var(--surface-muted); padding: 20px; border-radius: var(--radius); }
        .info-item strong { display: block; color: var(--brand-600); margin-bottom: 6px; }
        .info-item p, .info-item a { color: var(--ink-500); font-size: 0.92rem; }
        .info-item a:hover { color: var(--brand-500); }
        .location-map iframe { border-radius: var(--radius); display: block; width: 100%; }

        @media (max-width: 820px) { .hero .container { grid-template-columns: 1fr; } .hero img { display: none; } }
        @media (max-width: 760px) { .contact-info { grid-template-columns: 1fr; } }
    </style>
</head>

<body>
    <header class="site-header">
        <div class="container">
            <a href="/home" class="brand"><span class="brand__mark">✚</span> Group of Hospitals</a>
            <nav>
                <ul class="nav-links">
                    <li><a href="/home">Home</a></li>
                    <li><a href="#departments">Departments</a></li>
                    <li><a href="/appointments">Your Appointments</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
            <div class="nav-user">
                <span class="avatar-chip">
                    <span class="avatar-dot"><%= (user && user.name ? user.name.trim()[0] : 'U').toUpperCase() %></span>
                    <%= user ? user.name : 'Guest' %>
                </span>
                <a href="/logout" class="icon-btn" title="Logout" aria-label="Logout">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </a>
            </div>
            <button class="nav-toggle" aria-label="Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
    </header>
