<section class="block" id="departments">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Specialities</span>
            <h2 class="section-title">Our Departments</h2>
            <p class="section-subtitle">World-class care across a wide range of specialities.</p>
        </div>
        <div class="cards">
            <% const departments = [
                { title: "Cardiology", image: "/assets/gmchCardiology.png", desc: "Comprehensive heart care services." },
                { title: "Neurology", image: "/assets/gmchNeurology.png", desc: "Specialized care for brain and nervous system disorders." },
                { title: "Orthopedics", image: "/assets/maxOrtho.png", desc: "Advanced treatments for bones and joints." },
                { title: "Radiology", image: "/assets/gmchRadiology.png", desc: "Imaging and diagnostics." },
                { title: "ENT (Ear, Nose, Throat)", image: "/assets/gmchENT.png", desc: "Care for ear, nose, and throat conditions." },
                { title: "Orthopedics", image: "/assets/gmchOrthopedics.png", desc: "Advanced treatments for bones and joints." },
                { title: "Gastroenterology", image: "/assets/gmchGastroenterology.png", desc: "Diagnosis and treatment of digestive disorders." }
            ]; %>

            <% departments.forEach(dept => { %>
                <div class="dept-card">
                    <img src="<%= dept.image %>" alt="<%= dept.title %>">
                    <h3><%= dept.title %></h3>
                    <p><%= dept.desc %></p>
                </div>
            <% }) %>
        </div>
    </div>
</section>
