<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | Group of Hospitals</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .page-banner { background: var(--brand-gradient); color: #fff; padding: 64px 0; text-align: center; position: relative; overflow: hidden; }
        .page-banner::after { content: ""; position: absolute; width: 360px; height: 360px; border-radius: 50%; background: rgba(255,255,255,0.08); top: -140px; right: -100px; }
        .page-banner h1 { color: #fff; font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 10px; position: relative; }
        .page-banner p { color: rgba(255,255,255,0.9); max-width: 620px; margin: 0 auto; position: relative; }

        .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
        .about-grid img { border-radius: var(--radius-lg); box-shadow: var(--shadow); }
        .about-text h2 { font-size: 1.6rem; margin: 18px 0 10px; }
        .about-text h2:first-child { margin-top: 0; }
        .about-text p { color: var(--ink-500); margin-bottom: 10px; }

        .slider-container { position: relative; overflow: hidden; }
        .team-container { display: flex; gap: 24px; transition: transform 0.5s ease-in-out; }
        .team-card { flex: 0 0 240px; background: var(--surface); border: 1px solid rgba(15,23,42,0.06); border-radius: var(--radius); padding: 24px; text-align: center; box-shadow: var(--shadow-sm); transition: transform 0.3s ease; }
        .team-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
        .team-card img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; margin: 0 auto 14px; box-shadow: 0 6px 16px rgba(15,23,42,0.18); }
        .team-card h3 { font-size: 1.1rem; margin-bottom: 4px; }
        .team-card p { color: var(--brand-500); font-weight: 600; font-size: 0.92rem; }
        .arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 44px; height: 44px; border: none; border-radius: 50%; background: #fff; color: var(--brand-600); box-shadow: var(--shadow); cursor: pointer; font-size: 1.1rem; display: grid; place-items: center; }
        .arrow:hover { background: var(--brand-500); color: #fff; }
        .arrow-left { left: -6px; } .arrow-right { right: -6px; }

        .back-to-top { position: fixed; bottom: 24px; right: 24px; width: 48px; height: 48px; border: none; border-radius: 50%; background: var(--brand-gradient); color: #fff; font-size: 1.3rem; cursor: pointer; display: none; box-shadow: var(--shadow); z-index: 999; }

        @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; } }
    </style>
</head>

<body>
    <header class="site-header">
        <div class="container">
            <a href="/home" class="brand"><span class="brand__mark">✚</span> Group of Hospitals</a>
            <nav>
                <ul class="nav-links">
                    <li><a href="/home">Home</a></li>
                    <li><a href="/home/about">About Us</a></li>
                    <li><a href="/home/contact">Contact</a></li>
                </ul>
            </nav>
            <button class="nav-toggle" aria-label="Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
    </header>

    <section class="page-banner">
        <h1>Committed to Your Health</h1>
        <p>Leading the way in healthcare with compassionate service and state-of-the-art facilities.</p>
    </section>

    <section class="section">
        <div class="container">
            <div class="about-grid">
                <div class="about-text">
                    <span class="eyebrow">Who we are</span>
                    <h2>Our Mission</h2>
                    <p>At our hospitals, we strive to provide comprehensive healthcare services to all members of our community. Our mission is to deliver the highest quality care with compassion, dedication, and cutting-edge medical technology.</p>
                    <h2>Our Vision</h2>
                    <p>We envision a world where every individual has access to affordable, high-quality healthcare. By combining cutting-edge technology, expert medical professionals, and a patient-centric approach, we strive to redefine healthcare standards and make a meaningful difference in people's lives.</p>
                </div>
                <div class="about-image reveal">
                    <img src="/assets/gmchMain.png" alt="Hospital building" />
                </div>
            </div>
        </div>
    </section>

    <section class="section" style="background:#fff;">
        <div class="container text-center">
            <span class="eyebrow">What we do</span>
            <h2 class="section-title">Our Key Services</h2>
            <div class="grid grid--3">
                <% services.forEach(service => { %>
                    <div class="card reveal">
                        <div class="card__icon"><%= service.icon %></div>
                        <h3><%= service.title %></h3>
                        <p><%= service.description %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container text-center">
            <span class="eyebrow">Our people</span>
            <h2 class="section-title">Meet Our Expert Team</h2>
            <p class="section-subtitle">Experienced specialists dedicated to your well-being.</p>
            <div class="slider-container">
                <button class="arrow arrow-left" onclick="moveSlide(-1)">&#10094;</button>
                <div class="team-container" id="teamContainer">
                    <% doctors.forEach((doctor) => { %>
                        <div class="team-card">
                            <img src="<%= doctor.image %>" alt="<%= doctor.name %>">
                            <h3><%= doctor.name %></h3>
                            <p><%= doctor.specialization %></p>
                        </div>
                    <% }); %>
                </div>
                <button class="arrow arrow-right" onclick="moveSlide(1)">&#10095;</button>
            </div>
        </div>
    </section>

    <section class="section" style="background:#fff;">
        <div class="container text-center">
            <span class="eyebrow">Testimonials</span>
            <h2 class="section-title">What Our Patients Say</h2>
            <div class="grid grid--3">
                <% testimonials.forEach(test => { %>
                    <div class="card reveal">
                        <p style="font-size:1.05rem;">"<%= test.text %>"</p>
                        <p style="margin-top:14px;font-weight:700;color:var(--ink-900);">— <%= test.author %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="brand"><span class="brand__mark">✚</span> Group of Hospitals</div>
                    <p>Empowering healthcare every day with a trusted network of hospitals, expert doctors, and compassionate care.</p>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="/home">Home</a></li>
                        <li><a href="/home/about">About Us</a></li>
                        <li><a href="/home/contact">Contact</a></li>
                        <li><a href="/appointments">Appointments</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Contact</h4>
                    <ul>
                        <li><a href="tel:+911234567890">+91 234 567 890</a></li>
                        <li><a href="mailto:care@groupofhospitals.in">care@groupofhospitals.in</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">&copy; 2024 Group of Hospitals. All rights reserved.</div>
        </div>
    </footer>

    <button class="back-to-top" id="backToTop">↑</button>

    <script src="/js/ui.js"></script>
    <script>
        // Team carousel
        let scrollAmount = 0;
        const teamContainer = document.getElementById('teamContainer');
        const firstCard = document.querySelector('.team-card');
        const cardWidth = firstCard ? firstCard.offsetWidth + 24 : 264;

        function moveSlide(direction) {
            const maxScroll = teamContainer.scrollWidth - teamContainer.clientWidth;
            scrollAmount += direction * cardWidth;
            if (scrollAmount < 0) scrollAmount = 0;
            if (scrollAmount > maxScroll) scrollAmount = maxScroll;
            teamContainer.style.transform = `translateX(${-scrollAmount}px)`;
        }

        // Back to top
        const backBtn = document.getElementById('backToTop');
        window.addEventListener('scroll', () => {
            backBtn.style.display = window.scrollY > 400 ? 'grid' : 'none';
        });
        backBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
</body>

</html>
