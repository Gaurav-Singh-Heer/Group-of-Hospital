<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | Group of Hospitals</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .hero {
            background: var(--brand-gradient);
            color: #fff;
            padding: 70px 0 80px;
            position: relative; overflow: hidden;
        }
        .hero::after { content: ""; position: absolute; width: 460px; height: 460px; border-radius: 50%;
            background: rgba(255,255,255,0.08); bottom: -180px; left: -120px; }
        .hero .container { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 40px; position: relative; z-index: 1; }
        .hero h1 { color: #fff; font-size: clamp(2.1rem, 4.5vw, 3.1rem); margin-bottom: 16px; }
        .hero p { color: rgba(255,255,255,0.92); font-size: 1.1rem; max-width: 500px; margin-bottom: 28px; }
        .hero__cta { display: flex; gap: 14px; flex-wrap: wrap; }
        .hero__image img { filter: drop-shadow(0 20px 40px rgba(0,0,0,0.25)); }
        .hospital-card { text-align: left; }
        .hospital-card h3 { color: var(--brand-600); margin-bottom: 10px; }
        .hospital-card p { margin-bottom: 18px; }
        @media (max-width: 820px) { .hero .container { grid-template-columns: 1fr; } .hero__image { display: none; } }
    </style>
</head>

<body>
    <header class="site-header">
        <div class="container">
            <a href="/home" class="brand"><span class="brand__mark">✚</span> Group of Hospitals</a>
            <nav>
                <ul class="nav-links">
                    <li><a href="/home">Home</a></li>
                    <li><a href="#hospitals">Our Hospitals</a></li>
                    <li><a href="/appointments">Your Appointments</a></li>
                    <li><a href="/profile">My Profile</a></li>
                    <li><a href="/home/about">About</a></li>
                    <li><a href="/home/contact">Contact</a></li>
                </ul>
            </nav>
            <div class="nav-user">
                <a href="/profile" class="avatar-chip" style="text-decoration:none;">
                    <span class="avatar-dot"><%= (user && user.name ? user.name.trim()[0] : 'U').toUpperCase() %></span>
                    <%= user ? user.name : 'Guest' %>
                </a>
                <a href="/logout" class="icon-btn" title="Logout" aria-label="Logout">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </a>
            </div>
            <button class="nav-toggle" aria-label="Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <div class="hero__content">
                <h1>Your Trusted Healthcare Network</h1>
                <p>Discover reliable healthcare services across multiple hospitals, ensuring you and your family get the best care possible.</p>
                <div class="hero__cta">
                    <a href="#hospitals" class="btn btn--accent">Explore Hospitals</a>
                    <a href="/appointments" class="btn btn--ghost">Your Appointments</a>
                </div>
            </div>
            <div class="hero__image">
                <img src="/assets/header.svg" alt="Healthcare illustration">
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="section" id="features">
        <div class="container text-center">
            <span class="eyebrow">Why choose us</span>
            <h2 class="section-title">Why Choose Group of Hospitals?</h2>
            <p class="section-subtitle">Everything you need for a seamless healthcare experience.</p>
            <div class="grid grid--3">
                <% const icons = ['🏆','👨‍⚕️','🕑','🗺️','📅','💙']; %>
                <% features.forEach((feature, i) => { %>
                    <div class="card reveal">
                        <div class="card__icon"><%= icons[i % icons.length] %></div>
                        <h3><%= feature.title %></h3>
                        <p><%= feature.description %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Hospitals -->
    <section class="section" id="hospitals" style="background:#fff;">
        <div class="container text-center">
            <span class="eyebrow">Our network</span>
            <h2 class="section-title">Our Hospital Network</h2>
            <p class="section-subtitle">Choose a hospital to view departments and book an appointment.</p>
            <div class="grid grid--3">
                <% hospitals.forEach(hospital => { %>
                    <div class="card hospital-card reveal">
                        <h3><%= hospital.name %></h3>
                        <p><%= hospital.description %></p>
                        <a href="<%= hospital.link %>" class="btn btn--outline">Explore More</a>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="brand"><span class="brand__mark">✚</span> Group of Hospitals</div>
                    <p>Empowering healthcare every day with a trusted network of hospitals, expert doctors, and compassionate care.</p>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="/home">Home</a></li>
                        <li><a href="/appointments">Your Appointments</a></li>
                        <li><a href="/home/about">About Us</a></li>
                        <li><a href="/home/contact">Contact</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Contact</h4>
                    <ul>
                        <li><a href="tel:+911234567890">+91 234 567 890</a></li>
                        <li><a href="mailto:care@groupofhospitals.in">care@groupofhospitals.in</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">&copy; 2024 Group of Hospitals. Empowering Healthcare Every Day.</div>
        </div>
    </footer>

    <!-- Chatbot Button -->
    <div class="chatbot-btn" id="chatbot-btn">
        <img src="/assets/chatBot.jpg" alt="Chat with us" class="chat-icon" />
    </div>

    <!-- Chatbot Container -->
    <div class="chatbot-container" id="chatbot-container">
        <div class="chatbot-header">
            Sahayak — Virtual Assistant
            <button class="chatbot-close-btn" id="chatbot-close-btn">&times;</button>
        </div>
        <div class="chatbot-body" id="chatbot-body">
            <div class="chatbot-message">Hello! I am Sahayak, your virtual assistant. How can I help you today?</div>
        </div>
        <div class="chatbot-footer">
            <input type="text" class="chatbot-input" id="user-input" placeholder="Type your message..." />
            <button class="chatbot-send-btn" id="send-btn">Send</button>
        </div>
    </div>

    <script src="/js/ui.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"
        integrity="sha512-7eHRwcbYkK4d9g/6tD/mhkf++eoTHwpNM9woBxtPUBWm67zeAfFC+HrdoE2GanKeocly/VxeLvIqwvCdk7qScg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        gsap.from(".hero__content", { opacity: 0, x: -40, duration: 0.8, ease: "power2.out" });
        gsap.from(".hero__image", { opacity: 0, x: 40, duration: 0.8, ease: "power2.out" });
    </script>
    <script>
        // Chatbot open/close
        document.getElementById('chatbot-btn').addEventListener('click', function () {
            document.getElementById('chatbot-container').style.display = 'flex';
        });
        document.getElementById('chatbot-close-btn').addEventListener('click', function () {
            document.getElementById('chatbot-container').style.display = 'none';
        });

        async function sendMessageToBackend(userMessage, followUp) {
            try {
                const response = await fetch('/sahayak', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userMessage, followUp }),
                });
                const data = await response.json();
                data.message = data.message.replace("```html", "");
                data.message = data.message.replace("```", "");
                return data.message;
            } catch (error) {
                console.error('Error:', error);
                return "Sorry, I couldn't reach the server. Try again later.";
            }
        }

        document.getElementById('send-btn').addEventListener('click', sendChat);
        document.getElementById('user-input').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') sendChat();
        });

        async function sendChat() {
            const inputEl = document.getElementById('user-input');
            const userInput = inputEl.value.trim();
            const body = document.getElementById('chatbot-body');
            const followUp = Array.from(body.children).map(child => child.textContent);

            if (!userInput) return;

            const userMessageDiv = document.createElement('div');
            userMessageDiv.classList.add('user-message');
            userMessageDiv.textContent = userInput;
            body.appendChild(userMessageDiv);
            inputEl.value = '';
            body.scrollTop = body.scrollHeight;

            const chatbotResponse = await sendMessageToBackend(userInput, followUp);

            const chatbotMessageDiv = document.createElement('div');
            chatbotMessageDiv.classList.add('chatbot-message');
            chatbotMessageDiv.innerHTML = chatbotResponse;
            body.appendChild(chatbotMessageDiv);
            body.scrollTop = body.scrollHeight;
        }
    </script>
</body>

</html>
