<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | Group of Hospitals</title>
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    .admin-head { padding: 40px 0 10px; }
    .admin-head h1 { font-size: 1.8rem; }
    .admin-head p { color: var(--ink-500); }
    .stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 24px 0; }
    .stat-box { background: #fff; border: 1px solid rgba(15,23,42,0.06); border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow-sm); }
    .stat-box .num { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.9rem; font-weight: 800; color: var(--brand-600); }
    .stat-box .label { color: var(--ink-500); font-size: 0.9rem; }

    .toolbar { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; align-items: center; }
    .toolbar input, .toolbar select { padding: 11px 14px; border: 1.5px solid var(--ink-300); border-radius: var(--radius-sm); font: inherit; font-size: 0.95rem; }
    .toolbar input { flex: 1; min-width: 200px; }

    .table-wrap { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); overflow-x: auto; margin-bottom: 60px; }
    table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 760px; }
    thead th { background: var(--brand-gradient); color: #fff; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.78rem; font-weight: 600; padding: 14px 16px; text-align: left; white-space: nowrap; }
    td { padding: 13px 16px; border-bottom: 1px solid var(--surface-muted); font-size: 0.92rem; color: var(--ink-700); }
    tbody tr:hover { background: var(--surface-muted); }
    tr:last-child td { border-bottom: none; }
    .pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; background: rgba(67,97,238,0.1); color: var(--brand-600); }
    .mini-btn { border: none; cursor: pointer; border-radius: 999px; padding: 6px 13px; font: inherit; font-size: 0.82rem; font-weight: 600; background: rgba(247,37,133,0.1); color: var(--pink); transition: all 0.2s; }
    .mini-btn:hover { background: var(--pink); color: #fff; }
    .empty-row td { text-align: center; color: var(--ink-500); padding: 40px; }

    .section-label { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--ink-900); margin: 10px 0 16px; }
    .role-badge { display: inline-block; padding: 3px 11px; border-radius: 999px; font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; }
    .role-badge.admin { background: rgba(6,214,160,0.15); color: var(--accent-dark); }
    .role-badge.user { background: var(--surface-muted); color: var(--ink-500); }
    .role-btn { border: none; cursor: pointer; border-radius: 999px; padding: 6px 14px; font: inherit; font-size: 0.82rem; font-weight: 600; transition: all 0.2s; }
    .role-btn.promote { background: rgba(6,214,160,0.14); color: var(--accent-dark); }
    .role-btn.promote:hover { background: var(--accent); color: #05312a; }
    .role-btn.demote { background: rgba(247,37,133,0.1); color: var(--pink); }
    .role-btn.demote:hover { background: var(--pink); color: #fff; }
    .role-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .you-tag { font-size: 0.76rem; color: var(--ink-500); font-style: italic; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/admin" class="brand"><span class="brand__mark">✚</span> Group of Hospitals <span class="pill" style="margin-left:6px;">Admin</span></a>
      <nav>
        <ul class="nav-links">
          <li><a href="/admin">Dashboard</a></li>
          <li><a href="/home">Site Home</a></li>
          <li><a href="/profile">My Profile</a></li>
          <li><a href="/logout">Logout</a></li>
        </ul>
      </nav>
      <button class="nav-toggle" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <div class="container">
    <div class="admin-head">
      <h1>Admin Dashboard</h1>
      <p>Manage appointments across all hospitals.</p>
    </div>

    <div class="stats-row">
      <div class="stat-box"><div class="num"><%= totalAppointments %></div><div class="label">Total Appointments</div></div>
      <div class="stat-box"><div class="num"><%= totalUsers %></div><div class="label">Registered Users</div></div>
      <div class="stat-box"><div class="num"><%= hospitals.length %></div><div class="label">Hospitals</div></div>
    </div>

    <h2 class="section-label">Appointments</h2>

    <form class="toolbar" method="GET" action="/admin">
      <input type="text" name="q" value="<%= filters.q %>" placeholder="Search by name, email, or department...">
      <select name="hospital">
        <option value="">All hospitals</option>
        <% hospitals.forEach(h => { %>
          <option value="<%= h %>" <%= filters.hospital === h ? 'selected' : '' %>><%= h %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn--primary">Filter</button>
      <% if (filters.q || filters.hospital) { %><a href="/admin" class="btn btn--outline">Reset</a><% } %>
    </form>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th><th>Email</th><th>Age</th><th>Gender</th>
            <th>Department</th><th>Date</th><th>Hospital</th><th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (appointments.length === 0) { %>
            <tr class="empty-row"><td colspan="8">No appointments match your filters.</td></tr>
          <% } %>
          <% appointments.forEach(app => { %>
            <tr>
              <td><%= app.name %></td>
              <td><%= app.email %></td>
              <td><%= app.age %></td>
              <td><%= app.gender %></td>
              <td><%= app.department %></td>
              <td><%= new Date(app.date).toLocaleDateString() %></td>
              <td><span class="pill"><%= app.hospital %></span></td>
              <td><button class="mini-btn" data-id="<%= app._id %>" data-name="<%= app.name %>">Delete</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <h2 class="section-label" style="margin-top:40px;">Users &amp; Roles</h2>
    <p style="color:var(--ink-500); margin-bottom:16px; font-size:0.92rem;">Promote trusted users to admin or revoke access. Changes take effect the next time that user logs in.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.name %></td>
              <td><%= u.email %> <% if (u.email === currentEmail) { %><span class="you-tag">(you)</span><% } %></td>
              <td><span class="role-badge <%= u.role %>"><%= u.role %></span></td>
              <td>
                <% if (u.email === currentEmail) { %>
                  <button class="role-btn demote" disabled title="You cannot change your own role">Make User</button>
                <% } else if (u.role === 'admin') { %>
                  <button class="role-btn demote" data-id="<%= u._id %>" data-email="<%= u.email %>" data-role="user">Make User</button>
                <% } else { %>
                  <button class="role-btn promote" data-id="<%= u._id %>" data-email="<%= u.email %>" data-role="admin">Make Admin</button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <script src="/js/ui.js"></script>
  <script>
    document.querySelectorAll('.mini-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm(`Delete the appointment for ${btn.dataset.name}?`)) return;
        try {
          const res = await fetch(`/admin/appointments/${btn.dataset.id}`, { method: 'DELETE' });
          const data = await res.json();
          if (res.ok) { btn.closest('tr').remove(); }
          else { alert(data.error || 'Could not delete.'); }
        } catch (e) { alert('Network error. Please try again.'); }
      });
    });

    // Promote / demote users
    document.querySelectorAll('.role-btn:not(:disabled)').forEach(btn => {
      btn.addEventListener('click', async () => {
        const newRole = btn.dataset.role;
        const verb = newRole === 'admin' ? 'make an admin' : 'change to a regular user';
        if (!confirm(`Are you sure you want to ${verb}: ${btn.dataset.email}?`)) return;
        try {
          const res = await fetch(`/admin/users/${btn.dataset.id}/role`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ role: newRole })
          });
          const data = await res.json();
          if (res.ok) { window.location.reload(); }
          else { alert(data.error || 'Could not update role.'); }
        } catch (e) { alert('Network error. Please try again.'); }
      });
    });
  </script>
</body>
</html>
