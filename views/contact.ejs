<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Group of Hospitals</title>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .page-banner { background: var(--brand-gradient); color: #fff; padding: 64px 0; text-align: center; position: relative; overflow: hidden; }
        .page-banner::after { content: ""; position: absolute; width: 360px; height: 360px; border-radius: 50%; background: rgba(255,255,255,0.08); bottom: -160px; left: -100px; }
        .page-banner h1 { color: #fff; font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 10px; position: relative; }
        .page-banner p { color: rgba(255,255,255,0.9); position: relative; }

        .contact-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 32px; align-items: start; }
        .info-list { display: flex; flex-direction: column; gap: 16px; }
        .info-item { display: flex; gap: 14px; align-items: flex-start; }
        .info-item .ico { width: 46px; height: 46px; flex: none; border-radius: 12px; background: rgba(67,97,238,0.1); color: var(--brand-500); display: grid; place-items: center; font-size: 1.2rem; }
        .info-item strong { display: block; color: var(--ink-900); margin-bottom: 2px; }
        .info-item a { color: var(--ink-500); }
        .info-item a:hover { color: var(--brand-500); }
        @media (max-width: 760px) { .contact-grid { grid-template-columns: 1fr; } }
    </style>
</head>

<body>
    <header class="site-header">
        <div class="container">
            <a href="/home" class="brand"><span class="brand__mark">✚</span> Group of Hospitals</a>
            <nav>
                <ul class="nav-links">
                    <li><a href="/home">Home</a></li>
                    <li><a href="/home/about">About Us</a></li>
                    <li><a href="/home/contact">Contact</a></li>
                </ul>
            </nav>
            <button class="nav-toggle" aria-label="Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
    </header>

    <section class="page-banner">
        <h1>Get in Touch</h1>
        <p>We're here to help — reach out anytime.</p>
    </section>

    <section class="section">
        <div class="container">
            <div class="contact-grid">
                <div class="card">
                    <h2 style="margin-bottom:20px;">Contact Information</h2>
                    <div class="info-list">
                        <div class="info-item">
                            <span class="ico">📞</span>
                            <div><strong>Emergency Contact</strong><a href="tel:+91234567890">+91 234 567 890</a></div>
                        </div>
                        <div class="info-item">
                            <span class="ico">🏥</span>
                            <div><strong>Direct Hospital Contact</strong><a href="tel:+91987654321">+91 987 654 321</a></div>
                        </div>
                        <div class="info-item">
                            <span class="ico">✉️</span>
                            <div><strong>Email</strong><a href="mailto:care@groupofhospitals.in">care@groupofhospitals.in</a></div>
                        </div>
                        <div class="info-item">
                            <span class="ico">📍</span>
                            <div><strong>Visit Us</strong><a href="#">Find our locations</a></div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <h2 style="margin-bottom:20px;">Send Us a Message</h2>
                    <form id="contactForm" action="/home/contact" method="POST">
                        <div class="field">
                            <label for="c-name">Your Name</label>
                            <input type="text" id="c-name" name="name" placeholder="Jane Doe" required>
                        </div>
                        <div class="field">
                            <label for="c-email">Your Email</label>
                            <input type="email" id="c-email" name="email" placeholder="you@example.com" required>
                        </div>
                        <div class="field">
                            <label for="c-message">Your Message</label>
                            <textarea id="c-message" name="message" rows="5" placeholder="How can we help?" required></textarea>
                        </div>
                        <button type="submit" class="btn btn--primary btn--block">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="brand"><span class="brand__mark">✚</span> Group of Hospitals</div>
                    <p>Empowering healthcare every day with a trusted network of hospitals, expert doctors, and compassionate care.</p>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="/home">Home</a></li>
                        <li><a href="/home/about">About Us</a></li>
                        <li><a href="/home/contact">Contact</a></li>
                        <li><a href="/appointments">Appointments</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Contact</h4>
                    <ul>
                        <li><a href="tel:+911234567890">+91 234 567 890</a></li>
                        <li><a href="mailto:care@groupofhospitals.in">care@groupofhospitals.in</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">&copy; 2024 Group of Hospitals. All rights reserved.</div>
        </div>
    </footer>

    <script src="/js/ui.js"></script>
    <script>
        document.getElementById('contactForm').addEventListener('submit', function (e) {
            e.preventDefault();
            alert("Message sent successfully!");
            this.submit();
        });
    </script>
</body>

</html>
