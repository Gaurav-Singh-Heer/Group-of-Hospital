<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile | Group of Hospitals</title>
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    .profile-wrap { max-width: 720px; margin: 48px auto 72px; }
    .profile-head { display: flex; align-items: center; gap: 18px; margin-bottom: 28px; }
    .profile-head .big-avatar { width: 72px; height: 72px; border-radius: 50%; background: var(--brand-gradient); color: #fff; display: grid; place-items: center; font-size: 1.8rem; font-weight: 800; flex: none; }
    .profile-head h1 { font-size: 1.6rem; }
    .profile-head p { color: var(--ink-500); }
    .stats-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 28px; }
    .stat-box { background: #fff; border: 1px solid rgba(15,23,42,0.06); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow-sm); }
    .stat-box .num { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.6rem; font-weight: 800; color: var(--brand-600); }
    .stat-box .label { color: var(--ink-500); font-size: 0.88rem; }
    .alert { padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 0.92rem; font-weight: 600; }
    .alert.ok { background: rgba(6,214,160,0.12); color: var(--accent-dark); }
    .alert.err { background: rgba(247,37,133,0.1); color: var(--pink); }
    .divider { border: none; border-top: 1px solid var(--surface-muted); margin: 26px 0; }
    .muted-note { color: var(--ink-500); font-size: 0.85rem; margin-top: -8px; margin-bottom: 16px; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/home" class="brand"><span class="brand__mark">✚</span> Group of Hospitals</a>
      <nav>
        <ul class="nav-links">
          <li><a href="/home">Home</a></li>
          <li><a href="/appointments">Your Appointments</a></li>
          <li><a href="/profile">My Profile</a></li>
          <li><a href="/logout">Logout</a></li>
        </ul>
      </nav>
      <button class="nav-toggle" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <div class="container">
    <div class="profile-wrap">
      <div class="profile-head">
        <div class="big-avatar"><%= user.name.trim()[0].toUpperCase() %></div>
        <div>
          <h1><%= user.name %></h1>
          <p><%= user.email %> · <%= user.role === 'admin' ? 'Administrator' : 'Patient' %></p>
        </div>
      </div>

      <div class="stats-row">
        <div class="stat-box"><div class="num"><%= appointmentCount %></div><div class="label">Total Appointments</div></div>
        <div class="stat-box"><div class="num"><%= user.role === 'admin' ? 'Admin' : 'Active' %></div><div class="label">Account Status</div></div>
      </div>

      <div class="card">
        <h2 style="margin-bottom:18px;">Account Settings</h2>

        <% if (message) { %><div class="alert ok"><%= message %></div><% } %>
        <% if (error) { %><div class="alert err"><%= error %></div><% } %>

        <form action="/profile" method="POST">
          <div class="field">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" value="<%= user.name %>" required>
          </div>
          <div class="field">
            <label for="email">Email (cannot be changed)</label>
            <input type="email" id="email" value="<%= user.email %>" disabled>
          </div>

          <hr class="divider">
          <h3 style="margin-bottom:14px;">Change Password</h3>
          <p class="muted-note">Leave these blank to keep your current password.</p>

          <div class="field">
            <label for="currentPassword">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" placeholder="••••••••">
          </div>
          <div class="field">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" placeholder="At least 8 characters">
          </div>

          <button type="submit" class="btn btn--primary">Save Changes</button>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/ui.js"></script>
</body>
</html>
